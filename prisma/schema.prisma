generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  email          String    @unique @db.VarChar(255)
  name           String    @db.VarChar(255)
  createdAt      DateTime  @default(now())
  hashedPassword String    @db.VarChar(255)
  isVerified     Boolean   @default(false)
  u_id           String    @id @default(cuid())
  companies      Company[]
}

model VerificationToken {
  v_id    String   @id @default(cuid())
  email   String   @db.VarChar(255)
  token   String   @unique @db.VarChar(255)
  expires DateTime
}

model Company {
  c_id        String   @id @default(cuid())
  u_id        String
  cname       String   @db.VarChar(255)
  phoneNumber String   @db.VarChar(20)
  address     String   @db.VarChar(255)
  logoUrl     String?  @db.VarChar(255)
  description String?  @db.VarChar(255)
  website     String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  analytics        Analytics?
  user             User             @relation(fields: [u_id], references: [u_id])
  forms            FeedbackForm[]
  feedbacks        Feedback[]

  askAuricChats AskAuricChat[]
}

model FeedbackForm {
  formId    String     @id @default(cuid())
  c_id      String
  schema    Json
  title     String?    @db.VarChar(255)
  tagLine   String?    @db.VarChar(255)
  createdAt DateTime   @default(now())
  isActive  Boolean    @default(true)
  feedbacks Feedback[]
  company   Company    @relation(fields: [c_id], references: [c_id])
}

model Feedback {
  f_id      String  @id @default(cuid())
  formId    String
  c_id      String
  email     String  @db.VarChar(255)
  ipAddress String? @db.VarChar(100)

  name    String @db.VarChar(255)
  state   String @db.VarChar(255)
  country String @db.VarChar(255)
  age     Int

  data Json

  processingStatus ProcessingStatus @default(PENDING)

  retryCount Int @default(0)

  lastError String? @db.Text

  createdAt DateTime @default(now())

  form    FeedbackForm    @relation(fields: [formId], references: [formId])
  company Company         @relation(fields: [c_id], references: [c_id])
  result  FeedbackResult?

  @@unique([email, formId])
  @@index([email, formId])
  @@index([processingStatus])
}

model FeedbackResult {
  id String @id @default(cuid())

  f_id String @unique

  sentiment String
  sentimentScore Float

  rating Float?

  praisedFeatures Json
  criticizedFeatures Json

  testimonial String
  summary String

  confidence Float

  country String?
  countryIso2 String?
  countryFlag String?
  state String?
  formattedLocation String?

  createdAt DateTime @default(now())

  feedback Feedback @relation(fields: [f_id], references: [f_id])

  @@index([f_id])
}

model Analytics {
  c_id String @id

  avgRating Float
  avgSentiment Float
  auricScore Float

  totalFeedbacks Int

  sentimentDist Json
  ratingDist Json

  responseByLocation Json?

  topPraised Json
  topCriticized Json

  feedbackInsights Json?

  lastUpdated DateTime @default(now()) @updatedAt

  company Company @relation(fields: [c_id],references: [c_id])
}


model AskAuricChat {
  chatId String @id @default(cuid())

  c_id  String
  title String? @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [c_id], references: [c_id], onDelete: Cascade)

  messages AskAuricMessage[]

  @@index([c_id])
  @@index([updatedAt])
  @@map("ask_auric_chats")
}

model AskAuricMessage {
  messageId String @id @default(cuid())

  chatId  String
  role    String @db.VarChar(20)
  content String @db.Text

  metadata Json?

  createdAt DateTime @default(now())

  chat AskAuricChat @relation(fields: [chatId], references: [chatId], onDelete: Cascade)

  @@index([chatId])
  @@index([createdAt])
  @@map("ask_auric_messages")
}
