
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MessageRole {
  user
  assistant
}

enum MemoryImportance {
  LOW
  MEDIUM
  HIGH
}

model User {
  u_id           String    @id @default(cuid())
  email          String    @unique
  name           String
  hashedPassword String?
  emailVerified  DateTime?
  isVerified     Boolean   @default(false)
  createdAt      DateTime  @default(now())

  companies Company[]
  accounts  Account[]
  sessions  Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [u_id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [u_id], onDelete: Cascade)
}

model VerificationToken {
  v_id    String   @id @default(cuid())
  email   String   @db.VarChar(255)
  token   String   @unique @db.VarChar(255)
  expires DateTime
}

model Company {
  c_id        String   @id @default(cuid())
  u_id        String
  cname       String   @db.VarChar(255)
  phoneNumber String   @db.VarChar(20)
  address     String   @db.VarChar(255)
  logoUrl     String?  @db.VarChar(255)
  description String?  @db.VarChar(255)
  website     String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  user      User           @relation(fields: [u_id], references: [u_id])
  analytics Analytics?
  forms     FeedbackForm[]
  feedbacks Feedback[]
  chats      AuricChat[]
  documents  AuricDocument[]
  memories   AuricMemory[]
  settings   AuricSettings?
  tokenUsage AuricTokenUsage[]
}

model FeedbackForm {
  formId    String     @id @default(cuid())
  c_id      String
  schema    Json
  title     String?    @db.VarChar(255)
  tagLine   String?    @db.VarChar(255)
  createdAt DateTime   @default(now())
  isActive  Boolean    @default(true)

  feedbacks Feedback[]
  company   Company    @relation(fields: [c_id], references: [c_id])
}

model Feedback {
  f_id             String           @id @default(cuid())
  formId           String
  c_id             String
  email            String           @db.VarChar(255)
  ipAddress        String?          @db.VarChar(100)
  name             String           @db.VarChar(255)
  state            String           @db.VarChar(255)
  country          String           @db.VarChar(255)
  age              Int
  data             Json
  processingStatus ProcessingStatus @default(PENDING)
  retryCount       Int              @default(0)
  lastError        String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  form    FeedbackForm    @relation(fields: [formId], references: [formId])
  company Company         @relation(fields: [c_id], references: [c_id])
  result  FeedbackResult?

  @@unique([email, formId])
  @@index([email, formId])
  @@index([processingStatus])
}

model FeedbackResult {
  id                 String  @id @default(cuid())
  f_id               String  @unique
  sentiment          String
  sentimentScore     Float
  rating             Float?
  praisedFeatures    Json
  criticizedFeatures Json
  testimonial        String
  summary            String
  confidence         Float
  country            String?
  countryIso2        String?
  countryFlag        String?
  state              String?
  formattedLocation  String?
  createdAt          DateTime @default(now())

  feedback Feedback @relation(fields: [f_id], references: [f_id])

  @@index([f_id])
}

model Analytics {
  c_id               String   @id
  avgRating          Float
  avgSentiment       Float
  auricScore         Float
  totalFeedbacks     Int
  sentimentDist      Json
  ratingDist         Json
  responseByLocation Json?
  topPraised         Json
  topCriticized      Json
  feedbackInsights   Json?
  lastUpdated        DateTime @default(now()) @updatedAt

  company Company @relation(fields: [c_id], references: [c_id])
}
model AuricChat {
  chat_id   String   @id @default(cuid())
  c_id      String
  title     String?  @db.VarChar(255)  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company        @relation(fields: [c_id], references: [c_id], onDelete: Cascade)
  messages AuricMessage[]

  @@index([c_id])
  @@index([updatedAt])
  @@map("auric_chats")
}
model AuricMessage {
  message_id String      @id @default(cuid())
  chat_id    String
  role       MessageRole
  content    String      @db.Text
  metadata   Json?
  sources    Json?
  promptTokens     Int?
  completionTokens Int?

  createdAt DateTime @default(now())

  chat AuricChat @relation(fields: [chat_id], references: [chat_id], onDelete: Cascade)

  @@index([chat_id])
  @@index([createdAt])
  @@map("auric_messages")
}
model AuricDocument {
  document_id String   @id @default(cuid())
  c_id        String
  name        String   @db.VarChar(255)
  type        String   @db.VarChar(50)  
  storageKey  String   @db.VarChar(500) 
  uploadedAt  DateTime @default(now())

  company Company @relation(fields: [c_id], references: [c_id], onDelete: Cascade)

  @@index([c_id])
  @@map("auric_documents")
}
model AuricMemory {
  memory_id  String           @id @default(cuid())
  c_id       String
  fact       String           @db.Text
  category   String           @db.VarChar(100)
  importance MemoryImportance @default(MEDIUM)
  createdAt  DateTime         @default(now())
  lastUsed   DateTime?

  company Company @relation(fields: [c_id], references: [c_id], onDelete: Cascade)

  @@index([c_id])
  @@map("auric_memories")
}
model AuricTokenUsage {
  usage_id         String   @id @default(cuid())
  c_id             String
  month            Int
  year             Int
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [c_id], references: [c_id], onDelete: Cascade)

  @@unique([c_id, month, year])
  @@map("auric_token_usage")
}
model AuricSettings {
  c_id              String   @id
  monthlyTokenLimit Int      @default(1000000)
  internetEnabled   Boolean  @default(true)
  memoryEnabled     Boolean  @default(true)
  systemPrompt      String?  @db.Text 
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [c_id], references: [c_id], onDelete: Cascade)

  @@map("auric_settings")
}
